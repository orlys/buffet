@using BaGetter.Web.Extensions
@using BaGetter.Web.Helper
@using Microsoft.AspNetCore.Mvc.TagHelpers

@inject ApplicationVersion Version
@inject IUrlGenerator FeedUrls

@{
    var serviceIndexUrl = FeedUrls.GetServiceIndexUrl();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="NuGet package feed">
    <meta name="author" content="@Version.Authors">
    <meta name="color-scheme" content="light dark">
    @Html.AddReleaseMetaTags()

    <link rel="shortcut icon" href="~/_content/BaGetter.Web/favicon.ico">

    <link rel="stylesheet" href="~/_content/BaGetter.Web/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/_content/BaGetter.Web/css/site.css" asp-append-version="true" />

    <title>@ViewData["Title"]</title>
</head>
<body>
    <div class="page">
        <header class="masthead">
            <div class="masthead-title">
                @if (IsSectionDefined("Masthead"))
                {
                    @await RenderSectionAsync("Masthead")
                }
                else
                {
                    <h1>@ViewData["Title"]</h1>
                }
            </div>

            <a class="wordmark" asp-page="/Index" aria-label="All packages on @Context.Request.Host.Host">
                <span class="wordmark-host">@Context.Request.Host.Host</span>
                <span class="wordmark-kind">Package feed</span>
            </a>
        </header>

        <form class="search" action="@Url.Page("/Index")" method="get" role="search">
            <label class="sr-only" for="search-query">Search packages</label>
            <input type="search"
                   id="search-query"
                   name="q"
                   value="@ViewData["SearchQuery"]"
                   autocomplete="off"
                   placeholder="Search packages" />

            <button type="submit" class="pill pill-lg">Search</button>

            @await RenderSectionAsync("SearchForm", required: false)
        </form>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="colophon">
            <span>Service index · <code>@serviceIndexUrl</code></span>

            <button type="button"
                    class="pill"
                    data-copy="@serviceIndexUrl"
                    x-data="{ copied: false }"
                    @@click="window.baget.copyTextToClipboard($el.dataset.copy, $el); copied = true; setTimeout(() => copied = false, 1500)">
                <span x-text="copied ? 'Copied' : 'Copy URL'" aria-live="polite">Copy URL</span>
            </button>
        </footer>
    </div>

    <script src="~/_content/BaGetter.Web/lib/alpinejs/dist/alpine.js"></script>

    <script src="~/_content/BaGetter.Web/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/_content/BaGetter.Web/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/_content/BaGetter.Web/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

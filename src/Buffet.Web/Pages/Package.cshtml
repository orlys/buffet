@page "/packages/{id}/{version?}"
@model PackageModel

@{
    ViewData["Title"] = Model.Found
        ? Model.Package.Id + " " + Model.Package.NormalizedVersionString
        : Model.Package.Id;
}

@section Masthead
{
    <h1>@Model.Package.Id</h1>
    @if (Model.Found)
    {
        <p class="masthead-sub">
            <span class="pill">@Model.Package.NormalizedVersionString</span>
            @if (Model.Package.Authors.Any())
            {
                <span>by @string.Join(", ", Model.Package.Authors)</span>
            }
        </p>
    }
}

@if (!Model.Found)
{
    <div class="empty">
        <h2>Package not found</h2>
        <p class="muted">This feed has no package named <strong>@Model.Package.Id</strong>.</p>
        <p><a href="https://www.nuget.org/packages?q=@Uri.EscapeDataString(Model.Package.Id)" target="_blank" rel="noopener noreferrer">Search nuget.org for @Model.Package.Id</a></p>
        <a class="pill" asp-page="/Index">All packages</a>
    </div>
}
else
{
    <dl class="stats">
        <div>
            <dt>Total downloads</dt>
            <dd>@Model.TotalDownloads.ToString("N0")</dd>
        </div>
        <div>
            <dt>This version</dt>
            <dd>@Model.Package.Downloads.ToString("N0")</dd>
        </div>
        <div>
            <dt>Versions</dt>
            <dd>@Model.Versions.Count</dd>
        </div>
        <div>
            <dt>Last updated</dt>
            <dd>@Model.LastUpdated.Humanize()</dd>
        </div>
    </dl>

    <div class="package-layout">
        <article>
            <h2 class="section-label">Install</h2>

            <div x-data="{ tabs: tabs, active: tabs[0], copied: false }">
                <div class="install-tabs" role="tablist" aria-label="Install with">
                    <template x-for="tab in tabs" :key="tab.name">
                        <button type="button"
                                class="pill"
                                role="tab"
                                x-bind:class="{ 'is-active': tab.name === active.name }"
                                x-bind:aria-selected="(tab.name === active.name).toString()"
                                x-text="tab.name"
                                @@click="active = tab; copied = false"></button>
                    </template>
                </div>

                <div class="command" role="tabpanel">
                    <code class="command-text"><span class="command-prefix" x-show="active.prefix" x-text="active.prefix"></span><span x-text="active.content.join('\n')"></span></code>
                    <button type="button"
                            class="pill"
                            @@click="window.buffet.copyTextToClipboard(active.content.join('\n'), $el); copied = true; setTimeout(() => copied = false, 1500)">
                        <span x-text="copied ? 'Copied' : 'Copy'" aria-live="polite">Copy</span>
                    </button>
                </div>
            </div>

            @{
                CollapsibleSection("Readme", expanded: false,
                    @<div>
                        @if (Model.Readme == null)
                        {
                            <div class="prose pre-wrap">@Model.Package.Description</div>
                        }
                        else
                        {
                            <div class="prose">@Model.Readme</div>
                        }
                    </div>);
            }

            @if (!string.IsNullOrEmpty(Model.Package.ReleaseNotes))
            {
                CollapsibleSection("Release notes", expanded: false,
                    @<div class="prose pre-wrap">@Model.ParsedReleaseNotes</div>);
            }

            @{ CollapsibleSection("Dependencies", expanded: true,
                @<div>
                    @if (!Model.DependencyGroups.Any())
                    {
                        <p class="muted">This package has no dependencies.</p>
                    }
                    else
                    {
                        foreach (var group in Model.DependencyGroups)
                        {
                            <div class="dep-group">
                                <div class="dep-source">
                                    <span class="pill">@group.Name</span>
                                    <span class="flow" aria-hidden="true"></span>
                                </div>

                                @if (!group.Dependencies.Any())
                                {
                                    <p class="muted">No dependencies.</p>
                                }
                                else
                                {
                                    <ul class="squares">
                                        @foreach (var dependency in group.Dependencies)
                                        {
                                            <li>
                                                <a asp-page="Package"
                                                   asp-route-id="@dependency.PackageId"
                                                   asp-route-version="@null"><strong>@dependency.PackageId</strong></a>
                                                <span class="detail">· @dependency.VersionSpec</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    }
                </div>);
            }

            @if (!Model.IsDotnetTemplate && !Model.IsDotnetTool)
            {
                CollapsibleSection("Used by", expanded: false,
                    @<div>
                        @if (!Model.UsedBy.Any())
                        {
                            <p class="muted">No packages on this feed depend on @Model.Package.Id.</p>
                        }
                        else
                        {
                            <p class="muted">The 20 most downloaded packages that depend on @Model.Package.Id.</p>
                            <ul class="squares">
                                @foreach (var package in Model.UsedBy)
                                {
                                    <li>
                                        <a href="@Url.Page("/Package", new { package.Id })"><strong>@package.Id</strong></a>
                                        <span class="detail">· @package.TotalDownloads.ToString("N0") downloads</span>
                                        @if (!string.IsNullOrWhiteSpace(package.Description))
                                        {
                                            <div class="detail">@package.Description</div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>);
            }

            @{ CollapsibleSection("Versions", expanded: true,
                @<div x-data="{ showAll: false }">
                    <table class="versions">
                        <thead>
                            <tr>
                                <th scope="col">Version</th>
                                <th scope="col" class="num">Downloads</th>
                                <th scope="col" class="num">Last updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Versions.Count; i++)
                            {
                                var version = Model.Versions[i];
                                var alwaysShow = Json.Serialize(i < DefaultVisibleVersions);

                                <tr class="@(version.Selected ? "is-current" : "")" x-show="showAll || @alwaysShow">
                                    <td>
                                        <a asp-page="Package" asp-route-version="@version.Version" aria-current="@(version.Selected ? "page" : null)">@version.Version.ToNormalizedString()</a>
                                    </td>
                                    <td class="num">@version.Downloads.ToString("N0")</td>
                                    <td class="num">@version.LastUpdated.ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (Model.Versions.Count > DefaultVisibleVersions)
                    {
                        <button type="button" class="pill show-more" @@click="showAll = !showAll">
                            <span x-text="showAll ? 'Show fewer versions' : 'Show all @Model.Versions.Count versions'">Show all @Model.Versions.Count versions</span>
                        </button>
                    }
                </div>);
            }
        </article>

        <aside class="package-aside">
            <section class="aside-section">
                <h2 class="section-label">Links</h2>

                <ul class="squares">
                    @if (Model.Package.ProjectUrlString != null)
                    {
                        <li><a href="@Model.Package.ProjectUrlString">Project website</a></li>
                    }

                    @if (Model.Package.RepositoryUrlString != null)
                    {
                        <li><a href="@Model.Package.RepositoryUrlString">Source code</a></li>
                    }

                    @if (Model.LicenseUrl != null)
                    {
                        <li><a href="@Model.LicenseUrl">License</a></li>
                    }

                    <li><a href="@Model.PackageDownloadUrl">Download .nupkg</a></li>
                </ul>
            </section>

            <section class="aside-section">
                <h2 class="section-label">Package</h2>

                <div class="icon-box">
                    <img src="@(Model.IconUrl ?? Url.Content("~/_content/Buffet.Web/images/default-package-icon-256x256.png"))"
                         onerror="this.src='@Url.Content("~/_content/Buffet.Web/images/default-package-icon-256x256.png")'"
                         alt="" />
                </div>

                <ul class="squares">
                    <li><strong>@Model.Package.NormalizedVersionString</strong> <span class="detail">· published @Model.Package.Published.ToShortDateString()</span></li>
                    @if (Model.IsDotnetTool)
                    {
                        <li><strong>.NET tool</strong></li>
                    }
                    @if (Model.IsDotnetTemplate)
                    {
                        <li><strong>.NET template</strong></li>
                    }
                </ul>
            </section>

            @if (Model.Package.Tags.Any())
            {
                <section class="aside-section">
                    <h2 class="section-label">Tags</h2>

                    <ul class="tags">
                        @foreach (var tag in Model.Package.Tags)
                        {
                            <li class="pill pill-quiet">@tag</li>
                        }
                    </ul>
                </section>
            }
        </aside>
    </div>
}

@if (Model.Found)
{
    <script type="text/javascript">
        let tabs = [
            @if (Model.IsDotnetTemplate)
            {
                <text>
                {
                    name: ".NET CLI",
                    prefix: ">",
                    content: ["dotnet new --install @Model.Package.Id::@Model.Package.NormalizedVersionString"],
                },
                </text>
            }
            else if (Model.IsDotnetTool)
            {
                <text>
                {
                    name: ".NET CLI",
                    prefix: ">",
                    content: ["dotnet tool install --global @Model.Package.Id --version @Model.Package.NormalizedVersionString"],
                },
                </text>
            }
            else
            {
                <text>
                {
                    name: ".NET CLI",
                    prefix: ">",
                    content: ["dotnet add package @Model.Package.Id --version @Model.Package.NormalizedVersionString"],
                },
                {
                    name: "PackageReference",
                    prefix: "",
                    content: ["<PackageReference Include=\"@Model.Package.Id\" Version=\"@Model.Package.NormalizedVersionString\" />"]
                },
                {
                    name: "Paket CLI",
                    prefix: ">",
                    content: ["paket add @Model.Package.Id --version @Model.Package.NormalizedVersionString"]
                },
                {
                    name: "Package Manager",
                    prefix: "PM>",
                    content: ["Install-Package @Model.Package.Id -Version @Model.Package.NormalizedVersionString"]
                }
                </text>
            }
        ];
    </script>
}

@functions {

    private const int DefaultVisibleVersions = 5;

    private void CollapsibleSection(string title, bool expanded, Func<object, IHtmlContent> template)
    {
        <section x-data="{ expanded: @Json.Serialize(expanded) }">
            <h2 class="section-label">
                <button type="button"
                        class="section-toggle"
                        x-bind:aria-expanded="expanded.toString()"
                        aria-expanded="@Json.Serialize(expanded)"
                        @@click="expanded = !expanded">@title</button>
            </h2>

            <div x-show="expanded">@template(null)</div>
        </section>
    }
}
